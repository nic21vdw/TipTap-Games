# Copy to .env.local. Every one of these is optional: with none of them set,
# Tip Tap Games runs exactly as it does today — guest play, localStorage
# saves, seeded leaderboards, and a local fallback for game generation.

# --- Accounts, cloud saves and real leaderboards (Supabase) ----------------
# Both together switch on Google sign-in and cross-device sync. Found under
# Project Settings -> API in the Supabase dashboard. Safe to expose: the anon
# key is bound by the row-level security policies in supabase/schema.sql.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses row-level security, so it must never be prefixed
# NEXT_PUBLIC_ or committed. Only /api/runs/* and /api/admin/* use it — this
# is what lets a validated score be written when no browser can write one.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for every /api/admin/* route: sync-catalog, which pushes
# games/registry.ts into the `games` table, and season/season-winners, which
# open a month-long contest and draw its giveaway. Any long random string.
ADMIN_SYNC_SECRET=

# --- AI game generation ----------------------------------------------------
# Without it, /api/generate falls back to the local designer.
DEEPSEEK_API_KEY=
