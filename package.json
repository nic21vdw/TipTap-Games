    "react-dom": "^19.1.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.8",
    "@electric-sql/pglite": "^0.5.4",
    "@tailwindcss/postcss": "^4.1.8",
